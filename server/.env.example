# CARECONNECT Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Option 1: Public anon key (suitable for the current development setup)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Option 2: Server-only service-role key (optional)
# Use only when elevated server-side access is genuinely required.
# Never expose this key in frontend code or commit it to Git.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
