# CARECONNECT Client Environment Variables
# NOTE: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put your SUPABASE_SERVICE_ROLE_KEY here!

# Existing Supabase PostgreSQL Project
# Obtain these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Express API Base URL
VITE_API_BASE_URL=http://localhost:5000/api

